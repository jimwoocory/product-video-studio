generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id               String   @id
  name             String
  status           String
  targetPlatform   String   @default("douyin")
  targetDurationMs Int
  aspectRatio      String   @default("9:16")
  currentProductTruthId      String?
  currentProductTruthVersion Int?
  currentProductTruthHash    String?
  currentCreativeBatchId      String?
  currentCreativeBatchVersion Int?
  currentCreativeBatchHash    String?
  selectedCreativeId          String?
  currentScriptId      String?
  currentScriptVersion Int?
  currentScriptHash    String?
  currentProductionPlanId      String?
  currentProductionPlanVersion Int?
  currentProductionPlanHash    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  versions    VersionedEntity[]
  artifacts   ArtifactRecord[]
  blockers    WorkflowBlockerRecord[]
  requests    GenerationRequestRecord[]
  preflights  PreflightReportRecord[]
  approvals   UserApprovalRecord[]
  attempts    GenerationAttemptRecord[]
  providerIdentities ProviderIdentityRecord[]
  providerCapabilities ProviderCapabilityRecord[]
  commandAttempts CommandAttemptRecord[]
  reviewDecisions ReviewDecisionRecord[]
  finalAssemblies FinalAssemblyRecord[]
  publishAttempts PublishAttemptRecord[]
}

model VersionedEntity {
  id          String   @id
  projectId   String
  entityType  String
  entityKey   String
  version     Int
  status      String
  contentHash String
  dataJson    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, entityType, entityKey, version])
  @@index([projectId, entityType, status])
}

model ArtifactRecord {
  id              String   @id
  projectId       String
  kind            String
  relativePath    String
  sha256          String?
  sizeBytes       Int?
  mimeType        String?
  integrityStatus String
  immutable       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, relativePath])
  @@index([projectId, integrityStatus])
}

model WorkflowBlockerRecord {
  id                 String   @id
  projectId          String
  scope              String
  relatedEntityId    String?
  reasonCode         String
  message            String
  requiredUserAction String
  resumeCheckpoint   String
  createdAt          DateTime @default(now())
  resolvedAt         DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, resolvedAt])
}

model GenerationRequestRecord {
  id                      String   @id
  projectId               String
  clipId                  String
  compiledPromptId        String
  requestHash             String
  providerIdentityHash    String
  capabilityFingerprint   String
  status                  String   @default("CURRENT")
  dataJson                String
  createdAt               DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  preflights PreflightReportRecord[]
  approvals  UserApprovalRecord[]
  attempts   GenerationAttemptRecord[]

  @@index([projectId, clipId, status])
  @@unique([projectId, requestHash])
}

model PreflightReportRecord {
  id                    String   @id
  projectId             String
  generationRequestId   String
  requestHash           String
  status                String
  providerIdentityHash  String
  capabilityFingerprint String
  reportHash            String
  dataJson              String
  createdAt             DateTime @default(now())
  staleAt               DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  request GenerationRequestRecord @relation(fields: [generationRequestId], references: [id], onDelete: Restrict)
  approvals UserApprovalRecord[]
  attempts GenerationAttemptRecord[]

  @@index([projectId, status])
}

model UserApprovalRecord {
  id                    String   @id
  projectId             String
  generationRequestId   String
  preflightReportId     String
  requestHash           String
  preflightHash         String
  providerIdentityHash  String
  capabilityFingerprint String
  status                String
  approvalHash          String
  approvedAt            DateTime
  expiresAt             DateTime?
  dataJson              String

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  request GenerationRequestRecord @relation(fields: [generationRequestId], references: [id], onDelete: Restrict)
  preflight PreflightReportRecord @relation(fields: [preflightReportId], references: [id], onDelete: Restrict)
  attempt GenerationAttemptRecord?

  @@index([projectId, status])
}

model GenerationAttemptRecord {
  id                    String   @id
  projectId             String
  clipId                String
  attemptNumber         Int
  generationRequestId   String
  requestHash           String
  preflightReportId     String
  userApprovalId        String   @unique
  approvalHash          String
  submissionFingerprint String
  status                String
  externalTaskId        String?
  providerHandleJson    String?
  commandAttemptsJson   String
  outputArtifactId      String?
  createdAt             DateTime @default(now())
  submittedAt           DateTime?
  completedAt           DateTime?
  errorCode             String?
  errorMessage          String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  request GenerationRequestRecord @relation(fields: [generationRequestId], references: [id], onDelete: Restrict)
  preflight PreflightReportRecord @relation(fields: [preflightReportId], references: [id], onDelete: Restrict)
  approval UserApprovalRecord @relation(fields: [userApprovalId], references: [id], onDelete: Restrict)

  @@unique([clipId, attemptNumber])
  @@index([projectId, status])
}

model ProviderIdentityRecord {
  id                    String   @id
  projectId             String
  provider              String
  officialSourceUrl     String?
  publisher             String?
  packageName           String?
  executablePath        String
  executableSha256      String
  signatureInfo         String?
  cliVersion            String
  rawVersionArtifactId  String
  rawHelpArtifactId     String
  officialLoginOriginsJson String
  capabilityFingerprint String
  verificationStatus    String
  verifiedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  capabilities ProviderCapabilityRecord[]

  @@index([projectId, verificationStatus])
  @@index([executableSha256])
}

model ProviderCapabilityRecord {
  id                        String   @id
  projectId                 String
  provider                  String
  providerIdentityId        String?
  cliFound                  Boolean
  authenticated             String
  supportedOperationsJson   String
  supportedModelsJson       String
  supportedDurationsMsJson  String?
  rawProbeArtifactId        String
  capabilityFingerprint     String
  probedAt                  DateTime
  createdAt                 DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  identity ProviderIdentityRecord? @relation(fields: [providerIdentityId], references: [id], onDelete: Restrict)

  @@index([projectId, capabilityFingerprint])
  @@index([providerIdentityId])
}

model CommandAttemptRecord {
  id                    String   @id
  projectId             String
  generationAttemptId   String?
  operation             String
  attemptNumber         Int
  startedAt             DateTime
  completedAt           DateTime?
  exitCode              Int?
  signal                String?
  timedOut              Boolean
  stdoutArtifactId      String?
  stderrArtifactId      String?
  redactionRulesVersion String
  parserVersion         String
  errorCode             String?
  argvRedactedJson      String
  createdAt             DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, operation])
  @@index([generationAttemptId])
}

model ReviewDecisionRecord {
  id                    String   @id
  projectId             String
  clipId                String
  clipHash              String
  generationAttemptId   String?
  outputArtifactId      String?
  outputArtifactHash    String?
  decision              String
  note                  String?
  decidedAt             DateTime
  createdAt             DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, clipId, decidedAt])
  @@index([generationAttemptId])
}

model FinalAssemblyRecord {
  id                     String   @id
  projectId              String
  productionPlanHash     String
  selectedClipIdsJson    String
  inputArtifactIdsJson   String
  inputArtifactHashesJson String
  outputArtifactId       String
  outputArtifactHash     String
  status                 String
  createdAt              DateTime @default(now())
  acceptedAt             DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model PublishAttemptRecord {
  id               String   @id
  projectId        String
  finalAssemblyId  String
  platform         String
  status           String
  title            String
  description      String?
  externalVideoId  String?
  externalItemId   String?
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime @default(now())
  confirmedAt      DateTime?
  completedAt      DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([projectId, status])
}
